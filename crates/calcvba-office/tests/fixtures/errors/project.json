    {
      "name": "Api",
      "kind": 1,
      "source": "Public Function RunProbe() As String\r\n    Dim ws As Object, value As Double\r\n    Set ws = ThisWorkbook.Worksheets(1)\r\n    On Error Resume Next\r\n    value = 1# / 0#\r\n    ws.Range(\"A1\").Value2 = Err.Number\r\n    Err.Clear\r\n    ws.Range(\"A2\").Value2 = Err.Number\r\n    On Error GoTo Failed\r\n    value = 1# / 0#\r\n    ws.Range(\"A3\").Value2 = \"missed\"\r\n    RunProbe = \"ok\"\r\n    Exit Function\r\nFailed:\r\n    ws.Range(\"A3\").Value2 = Err.Number\r\n    Resume Done\r\nDone:\r\n    ws.Range(\"A4\").Value2 = \"resumed\"\r\n    RunProbe = \"ok\"\r\nEnd Function\r\n",
      "source_sha256": "sha256:9b3cc515b12142a2f04d2bf58811a181dc71a64caf85323549873fb2cb8dba2d",
      "host_type": null
    }
