    {
      "name": "Api",
      "kind": 1,
      "source": "Public Function RunProbe() As String\r\n    Dim ws As Object, dict As Object, entries As Variant\r\n    Set ws = ThisWorkbook.Worksheets(1)\r\n    Set dict = CreateObject(\"Scripting.Dictionary\")\r\n    dict.Add \"alpha\", 10&\r\n    dict.Add \"beta\", 20&\r\n    dict(\"alpha\") = dict(\"alpha\") + 3&\r\n    entries = dict.Keys\r\n    ws.Range(\"A1\").Value2 = dict.Count\r\n    ws.Range(\"A2\").Value2 = dict.Exists(\"beta\")\r\n    ws.Range(\"A3\").Value2 = dict(\"alpha\")\r\n    ws.Range(\"A4\").Value2 = entries(0)\r\n    dict.Remove \"beta\"\r\n    ws.Range(\"A5\").Value2 = dict.Count\r\n    RunProbe = \"ok\"\r\nEnd Function\r\n",
      "source_sha256": "sha256:9afc912f681539aecb9e0a01ab5318f27d9cd0cb80c70cdaf76d07dcf2dd9f5b",
