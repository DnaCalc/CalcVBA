    {
      "name": "Api",
      "kind": 1,
      "source": "Public Function RunProbe() As String\r\n    Dim ws As Object, r As Long, c As Long, total As Long\r\n    Set ws = ThisWorkbook.Worksheets(1)\r\n    For r = 1 To 3\r\n        For c = 1 To 4\r\n            ws.Cells(r, c).Value2 = r * 10 + c\r\n            total = total + ws.Cells(r, c).Value2\r\n        Next c\r\n    Next r\r\n    ws.Range(\"F1\").Value2 = total\r\n    RunProbe = \"ok\"\r\nEnd Function\r\n",
      "source_sha256": "sha256:6283f500cc443d760ae63fe62153047fab4aa47e00a174fcb68dfd502660a37e",
