      "name": "Sheet1",
      "kind": 100,
      "source": "Private Sub Worksheet_Change(ByVal Target As Excel.Range)\r\n    Dim result As Double\r\n    Hits = Hits + 1\r\n    result = 1# / 0#\r\n    Hits = Hits + 100\r\nEnd Sub\r\n",
      "source_sha256": "sha256:e61203493c7592e1e039ed7566a968324ea5945f4e3abcbade9a3cdb8bfe366c",
      "host_type": "Excel.Worksheet"
    },
    {
      "name": "Api",
      "kind": 1,
      "source": "Public Hits As Long\r\nPublic Function RunProbe() As String\r\n    Dim ws As Object, caught As Long\r\n    Set ws = ThisWorkbook.Worksheets(1)\r\n    On Error Resume Next\r\n    ws.Range(\"A1\").Value2 = 7#\r\n    caught = Err.Number\r\n    On Error GoTo 0\r\n    ThisWorkbook.Application.EnableEvents = False\r\n    ws.Range(\"C1\").Value2 = Hits\r\n    ws.Range(\"C2\").Value2 = caught\r\n    ThisWorkbook.Application.EnableEvents = True\r\n    RunProbe = \"ok\"\r\nEnd Function\r\n",
      "source_sha256": "sha256:7d41e0518f4b720e245f47e42dade47bfb9b75f48b1c9f3e6b2e67564b3f686a",
      "host_type": null
    }
