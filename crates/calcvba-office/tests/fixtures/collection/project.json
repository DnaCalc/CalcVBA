    {
      "name": "Api",
      "kind": 1,
      "source": "Public Function RunProbe() As String\r\n    Dim ws As Object, items As Collection\r\n    Set ws = ThisWorkbook.Worksheets(1)\r\n    Set items = New Collection\r\n    items.Add \"red\", \"r\"\r\n    items.Add \"blue\", \"b\"\r\n    items.Add \"green\", Before:=2\r\n    ws.Range(\"A1\").Value2 = items.Count\r\n    ws.Range(\"A2\").Value2 = items(2)\r\n    ws.Range(\"A3\").Value2 = items(\"b\")\r\n    items.Remove \"r\"\r\n    ws.Range(\"A4\").Value2 = items(1)\r\n    RunProbe = \"ok\"\r\nEnd Function\r\n",
      "source_sha256": "sha256:458bf2771f471081d0d339e003553fcd48eaca6a1b53571be6a6e6634efc28ed",
