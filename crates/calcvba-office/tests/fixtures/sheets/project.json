      "name": "Api",
      "kind": 1,
      "source": "Public Function RunProbe() As String\r\n    Dim book As Object, added As Object, removed As Object\r\n    Set book = ThisWorkbook\r\n    Set added = book.Worksheets.Add(After:=book.Worksheets(book.Worksheets.Count))\r\n    added.Name = \"Report\"\r\n    added.Range(\"A1\").Value2 = \"new sheet\"\r\n    Set removed = book.Worksheets.Add\r\n    removed.Name = \"Temporary\"\r\n    book.Application.DisplayAlerts = False\r\n    removed.Delete\r\n    book.Worksheets(1).Range(\"A1\").Value2 = book.Worksheets.Count\r\n    RunProbe = \"ok\"\r\nEnd Function\r\n",
      "source_sha256": "sha256:26903337cc17177383e450fa3f8c8bfcf18ddc07c9f64650ad74beee590375f8",
